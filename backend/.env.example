ENV=development
GROQ_API_KEY=your_groq_api_key_here
SPOONACULAR_API_KEY=your_spoonacular_key
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/mise?retryWrites=true&w=majority
COHERE_API_KEY=your_cohere_api_key_here
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:3000
REQUIRE_AUTH=false
LOCAL_FALLBACK_ON_DB_ERROR=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=4000
MONGO_CONNECT_TIMEOUT_MS=3000
MONGO_SOCKET_TIMEOUT_MS=5000
RAG_DB_FAILURE_COOLDOWN_SECONDS=60
ANTHROPIC_API_KEY=your_anthropic_api_key_here